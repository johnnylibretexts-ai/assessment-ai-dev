FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --gid 10002 assessment-compute \
    && useradd \
        --uid 10002 \
        --gid 10002 \
        --no-create-home \
        --home-dir /nonexistent \
        --shell /usr/sbin/nologin \
        assessment-compute \
    && mkdir -p /run/assessment-computation \
    && chown assessment-compute:assessment-compute /run/assessment-computation

COPY pyproject.toml uv.lock README.md Dockerfile.compute ./
COPY app ./app
COPY evaluation ./evaluation

RUN pip install \
        '.[compute]' \
    && python -m app.computation_runtime_identity build \
        --root /app \
        --output /app/computation-runtime-manifest.json

FROM base AS test

COPY tests ./tests
COPY docker-compose.computation.yml ./
RUN pip install '.[dev]' \
    && ruff check app/computation_service.py tests/test_computation_service.py \
    && ruff format --check app/computation_service.py tests/test_computation_service.py \
    && pytest -q tests/test_computation_service.py

FROM base AS runtime

# The project wheel also contains the offline qualification harness because the
# normal Assessment AI image exposes that CLI.  It is not part of the sidecar
# request path, so remove both installed project-package copies and the CLI from
# the runtime stage.  /app/app is the sole local Python tree and is covered by
# computation-runtime-manifest.json.
RUN rm -rf \
        /app/evaluation \
        /usr/local/lib/python3.12/site-packages/app \
        /usr/local/lib/python3.12/site-packages/evaluation \
    && rm -f /usr/local/bin/assessment-ai-evaluate \
    && python -c "import importlib.util, shutil; assert importlib.util.find_spec('evaluation') is None; assert shutil.which('assessment-ai-evaluate') is None"

USER assessment-compute

VOLUME ["/run/assessment-computation"]

CMD ["sh", "-c", "umask 000 && rm -f /run/assessment-computation/compute.sock && exec uvicorn app.computation_service:app --uds /run/assessment-computation/compute.sock --workers 1 --no-access-log"]
