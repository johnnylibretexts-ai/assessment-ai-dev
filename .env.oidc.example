# Runtime values live only in /opt/libretexts/assessment-ai/.env.oidc.
#
# Both values below are PLACEHOLDERS, not secrets.
#
# The cookie secret is deliberately an INVALID length. oauth2-proxy requires
# exactly 16, 24, or 32 bytes and refuses to start otherwise, so copying this
# file to .env.oidc without editing it fails loudly at boot. An all-zeros
# 32-byte value would be structurally valid and would boot -- silently running
# production on a cookie secret published in this repository.
#
# Generate a real one with:
#
#     openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_CLIENT_SECRET=replace-at-deploy
OAUTH2_PROXY_COOKIE_SECRET=replace-before-deploy
