ASSESSMENT_AI_DATABASE_URL=sqlite:////data/assessment-ai.db
ASSESSMENT_AI_ALLOWED_ORIGIN=https://assess-ai.libretexts.dev
ASSESSMENT_AI_SANDBOX_ROOT=Sandboxes/johnnyphung
ASSESSMENT_AI_CXONE_HOST=dev.libretexts.org
ASSESSMENT_AI_CXONE_ENV_FILE=/run/secrets/cxone.env

# Direct Ollama Cloud API. Keep the real key only in the VPS .env.
ASSESSMENT_AI_OLLAMA_BASE_URL=https://ollama.com
ASSESSMENT_AI_OLLAMA_MODEL=gpt-oss:120b
ASSESSMENT_AI_OLLAMA_API_KEY=

# Publishing stays disabled until an ADAPT service identity and owned folder exist.
ASSESSMENT_AI_ADAPT_PUBLISHING_ENABLED=false
